									"lineStyle": 0,
									"points": "1050:610;1050:685"
								},
								{
									"_type": "UMLNoteView",
									"_id": "bcA1YdM9EVfrysPd9/lk",
									"_parent": {
										"$ref": "BHID15Xb0QGnj1a9ANiN"
									},
									"text": "DR-05: A and every transfer it causes are committed together or not at all. If any step fails, the database transaction is rolled back and nothing is recorded. The router never holds money.",
									"left": 880,
									"top": 740,
									"width": 400,
									"height": 80
								},
								{
									"_type": "UMLNoteLinkView",
									"_id": "VNbZRGXfdDqk9RkqW47D",
									"_parent": {
										"$ref": "BHID15Xb0QGnj1a9ANiN"
									},
									"tail": {
										"$ref": "bcA1YdM9EVfrysPd9/lk"
									},
									"head": {
										"$ref": "GmiDWZbuCUj7Piy7Tkxt"
									},
									"lineStyle": 1,
									"points": "1080:780;1260:610;1050:610"
								},
								{
									"_type": "UMLNoteView",
									"_id": "zABUMiX6XO+iw05r4iiI",
									"_parent": {
										"$ref": "BHID15Xb0QGnj1a9ANiN"
									},
									"text": "Whole won only (int64, DR-03). The percentage is of the received amount A, not of what is left. Each rule takes at most what is left, so a later rule may receive less than its share, or nothing.",
									"left": 880,
									"top": 845,
									"width": 400,
									"height": 80
								},
								{
									"_type": "UMLNoteLinkView",
									"_id": "9QYR6aVOGbKPK3egxFdw",
									"_parent": {
										"$ref": "BHID15Xb0QGnj1a9ANiN"
									},
									"tail": {
										"$ref": "zABUMiX6XO+iw05r4iiI"
									},
									"head": {
										"$ref": "h2nBiyBL2pZFRDxNtHkw"
